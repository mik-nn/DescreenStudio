{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Descreen Studio Pro",
  "version": "0.4.0",
  "identifier": "com.descreen.studio",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Descreen Studio Pro",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["model.opt.onnx", "deps/onnxruntime.dll", "deps/DirectML.dll"]
  }
}
